---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/sign-up-styles.css';

const title = "Powerhouse PT - Contact form for Sports Physical Therapy Clinic in Laredo, Texas";
const description =
  "Sports Physical Therapy practice in Laredo, Texas (TX) operated and owned by Sandra Gomez. Treatment services include pain-relief (pain relief), manual therapy, tissue specific exercise training, sports performance, injury prevention, dry needling";
---

<BaseLayout title={title} description={description} fonts="ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900" aos>
  <Fragment slot="hero">
    <div class="container-fluid signup-form-heading-container">
      <div class="row">
        <span class="visually-hidden">Powerhouse PT - Sports Physical Therapy Clinic in Laredo, Texas</span>
        <img
          class="heading-logo hero-logo-animate"
          src="/images/powerhouse-logo.webp"
          alt="powerhouse pt physical therapy original logo"
        />
      </div>
    </div>
  </Fragment>

  <section id="sign-up">
    <div class="container-fluid sign-up-contact-wrapper">
      <div class="row g-0">
        <!-- Left: Form -->
        <div class="col-lg-6 sign-up-form-col">
          <h2 class="signup-col-title">Schedule A Free Call</h2>
          <form id="contact-form" class="row g-3" novalidate>
            <div class="col-md-6">
              <label for="firstName" class="form-label">First Name</label>
              <input
                type="text"
                class="form-control"
                id="firstName"
                name="first_name"
                required
              />
              <div class="invalid-feedback" id="firstName-feedback"></div>
            </div>
            <div class="col-md-6">
              <label for="lastName" class="form-label">Last Name</label>
              <input
                type="text"
                class="form-control"
                id="lastName"
                name="last_name"
                required
              />
              <div class="invalid-feedback" id="lastName-feedback"></div>
            </div>
            <div class="col-12">
              <label for="phone" class="form-label">Phone Number</label>
              <input
                type="tel"
                class="form-control"
                id="phone"
                name="phone"
                autocomplete="tel"
                inputmode="tel"
                maxlength="25"
                required
              />
              <div class="invalid-feedback" id="phone-feedback"></div>
            </div>
            <div class="col-12">
              <label for="email" class="form-label">Email</label>
              <input
                type="email"
                class="form-control"
                id="email"
                name="email"
                autocomplete="email"
                maxlength="254"
                required
              />
              <div class="invalid-feedback" id="email-feedback"></div>
            </div>
            <div class="col-12">
              <label for="insurance" class="form-label"
                >Insurance Provider</label
              >
              <select
                class="form-select"
                id="insurance"
                name="insurance"
                required
              >
                <option value="" disabled selected>
                  Select your insurance provider
                </option>
                <option value="None">None</option>
                <option value="Aetna">Aetna</option>
                <option value="Blue Cross Blue Shield">
                  Blue Cross Blue Shield
                </option>
                <option value="Cigna">Cigna</option>
                <option value="Humana">Humana</option>
                <option value="Medicare">Medicare</option>
                <option value="Medicaid">Medicaid</option>
                <option value="Tricare">Tricare</option>
                <option value="UnitedHealthcare">UnitedHealthcare</option>
                <option value="Other">Other</option>
              </select>
              <div class="invalid-feedback" id="insurance-feedback"></div>
            </div>
            <div class="col-12">
              <label for="goal" class="form-label">What's your goal?</label>
              <textarea
                class="form-control"
                id="goal"
                name="goal"
                rows="3"
                required
              ></textarea>
              <div class="invalid-feedback" id="goal-feedback"></div>
            </div>
            <div class="col-12">
              <button
                type="submit"
                id="submit-btn"
                class="w-100 btn btn-primary send-button"
              >
                <span id="btn-text">Send</span>
                <span
                  id="btn-spinner"
                  class="spinner-border spinner-border-sm ms-2"
                  role="status"
                  aria-label="Loading"
                  style="display: none"
                ></span>
              </button>
            </div>

            <!-- Success message -->
            <div id="form-success" class="col-12" style="display: none">
              <div class="alert form-alert-success" role="alert">
                <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>
                <strong>Message sent!</strong> We'll be in touch with you
                shortly.
              </div>
            </div>

            <!-- Error message -->
            <div id="form-error" class="col-12" style="display: none">
              <div class="alert form-alert-error" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2" aria-hidden="true"></i>
                <strong>Something went wrong.</strong> Please try again or
                call us at <a href="tel:+19563076305">956-307-6305</a>.
              </div>
            </div>
          </form>
        </div>

        <!-- Right: Contact Info + Map -->
        <div class="col-lg-6 sign-up-contact-col">
          <h2 class="signup-col-title">Contact Us</h2>
          <div class="contact-details">
            <span
              ><i class="fa-solid fa-phone" aria-hidden="true"></i> Phone:
              <a href="tel:+19563076305">956-307-6305</a> <br
            /></span>
            <span
              ><i class="fa-solid fa-fax" aria-hidden="true"></i> Fax: 956-857-3229 <br
            /></span>
            <span
              ><i class="fa-solid fa-envelope" aria-hidden="true"></i>
              <a href="mailto:INFO@POWERHOUSESPORTSPT.COM"
                >INFO@POWERHOUSESPORTSPT.COM</a
              ><br
            /></span>
            <span
              ><i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              <a href="https://maps.app.goo.gl/yDw3U9cw4icQMNew6"
                >2446 SAN ISIDRO PKWY - LOCATED IN GOLD'S GYM</a
              ><br
            /></span>
          </div>
          <div class="map-container">
            <iframe
              class="map"
              title="Map showing Powerhouse PT location at Gold's Gym, 2446 San Isidro Pkwy, Laredo TX"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d226282.67799933587!2d-99.61554858359375!3d27.603856700000005!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x866121cdb1abf8e9%3A0x14a5badb1a6861f9!2sPowerhouse%20PT-%20Physical%20Therapy!5e0!3m2!1sen!2sus!4v1781297069318!5m2!1sen!2sus"
              width="600"
              height="450"
              style="border: 0"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline>
      // Each validator returns an error message, or "" when the value is fine.
      const required = (label) => (value) => (value.trim() ? "" : `Please enter ${label}.`);

      const validators = {
        firstName: required("your first name"),
        lastName: required("your last name"),
        phone(value) {
          const phone = value.trim();
          if (!phone) return "Please enter your phone number.";
          // Any country: optional leading +, then digits with spaces, dashes, dots or parentheses.
          const digits = phone.replace(/\D/g, "");
          if (!/^\+?[\d\s().-]+$/.test(phone) || digits.length < 7 || digits.length > 15) {
            return "Please enter a valid phone number, including country code if outside the US.";
          }
          return "";
        },
        email(value) {
          const email = value.trim();
          if (!email) return "Please enter your email address.";
          if (!/^[^\s@]+@[^\s@.]+(\.[^\s@.]+)+$/.test(email)) {
            return "Please enter a valid email address, like name@example.com.";
          }
          return "";
        },
        insurance: (value) => (value ? "" : "Please select your insurance provider."),
        goal: required("your goal"),
      };

      function validateField(id) {
        const field = document.getElementById(id);
        const message = validators[id](field.value);
        field.classList.toggle("is-invalid", Boolean(message));
        field.setAttribute("aria-invalid", message ? "true" : "false");
        document.getElementById(id + "-feedback").textContent = message;
        return !message;
      }

      Object.keys(validators).forEach((id) => {
        const field = document.getElementById(id);
        field.setAttribute("aria-describedby", id + "-feedback");
        // Check when leaving a field, then re-check as the visitor corrects it
        field.addEventListener("blur", () => validateField(id));
        field.addEventListener("input", () => {
          if (field.classList.contains("is-invalid")) validateField(id);
        });
      });

      document
        .getElementById("contact-form")
        .addEventListener("submit", function (e) {
          e.preventDefault();

          const form = this;

          // Validate every field; stop and focus the first problem
          const invalid = Object.keys(validators).filter((id) => !validateField(id));
          if (invalid.length) {
            document.getElementById(invalid[0]).focus();
            return;
          }

          const btn = document.getElementById("submit-btn");
          const btnText = document.getElementById("btn-text");
          const spinner = document.getElementById("btn-spinner");
          const success = document.getElementById("form-success");
          const error = document.getElementById("form-error");

          // Loading state
          btn.disabled = true;
          btnText.textContent = "Sending...";
          spinner.style.display = "inline-block";
          success.style.display = "none";
          error.style.display = "none";

          // Use FormData to grab all fields by their "name" attribute
          const formData = new FormData(form);

          // Send request to the Netlify function
          fetch("/api/contact", {
            method: "POST",
            body: formData,
          })
            .then((response) => {
              if (!response.ok) throw new Error("Network response was not ok");
              return response.json();
            })
            .then((data) => {
              if (data.status === "success") {
                success.style.display = "block";
                form.reset();
              } else {
                throw new Error(data.message || "Unknown error");
              }
            })
            .catch((err) => {
              error.style.display = "block";
              console.error("Submission error:", err);
            })
            .finally(() => {
              btn.disabled = false;
              btnText.textContent = "Send";
              spinner.style.display = "none";
            });
        });
    </script>
  </Fragment>
</BaseLayout>
