---
// TEMPORARY: side-by-side test of list styles F–O for the service pages. Not linked, not indexed. Delete after choosing.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getService } from '../lib/content';

const s = getService('orthopedic-pt', 'en');
const options = [
  ['F', 'Serif text with a soft peach dot'],
  ['G', 'Small tracked capitals with a peach dash'],
  ['H', 'Serif with a thin peach bar on the left of each item'],
  ['I', 'Peach slash before each item'],
  ['J', 'Peach chevron (›) before each item'],
  ['K', 'Pills with a peach outline and peach text'],
  ['L', 'Italic serif in ivory, no markers'],
  ['M', 'Tiles with a peach line across the top'],
  ['N', 'Small peach diamond before each item'],
  ['O', 'Peach plus (+) before each item'],
];
---

<BaseLayout title="Style lab | Powerhouse PT" description="Temporary style comparison." translated={false} noindex>
  {options.map(([letter, label]) => (
    <section class="section section--alt section--tight" style="border-bottom: 1px solid var(--line);">
      <div class="wrap two-col">
        <div>
          <span class="eyebrow">Option {letter}</span>
          <h2 style="margin: 0;">{label}</h2>
        </div>
        <ul class={`lab lab--${letter.toLowerCase()}`}>
          {s.conditions.map((c) => <li set:html={c} />)}
        </ul>
      </div>
    </section>
  ))}
</BaseLayout>

<style is:global>
  .lab { --peach: color-mix(in srgb, var(--ember, var(--ink)) 65%, var(--ink)); margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 12px 28px; align-content: start; }
  .lab li { position: relative; }

  .lab--f li { padding-left: 20px; font: var(--display-weight) 1.15rem/1.35 var(--font-display); }
  .lab--f li::before { content: ''; position: absolute; left: 2px; top: 0.6em; width: 7px; height: 7px; border-radius: 50%; background: var(--peach); }

  .lab--g { gap: 14px 28px; }
  .lab--g li { padding-left: 22px; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2); line-height: 1.5; }
  .lab--g li::before { content: ''; position: absolute; left: 0; top: 0.75em; width: 12px; height: 1.5px; background: var(--peach); }

  .lab--h { gap: 16px 28px; }
  .lab--h li { padding-left: 16px; font: var(--display-weight) 1.15rem/1.35 var(--font-display); }
  .lab--h li::before { content: ''; position: absolute; left: 0; top: 0.15em; bottom: 0.15em; width: 2px; border-radius: 2px; background: var(--peach); }

  .lab--i li { padding-left: 22px; }
  .lab--i li::before { content: '/'; position: absolute; left: 2px; top: 0; color: var(--peach); font-weight: 600; }

  .lab--j li { padding-left: 20px; }
  .lab--j li::before { content: '\203A'; position: absolute; left: 2px; top: -0.08em; color: var(--peach); font-size: 1.3em; line-height: 1.2; }

  .lab--k { display: flex; flex-wrap: wrap; gap: 10px; }
  .lab--k li { padding: 8px 15px; border: 1px solid color-mix(in srgb, var(--peach) 55%, transparent); border-radius: var(--radius-pill); color: var(--peach); font-size: 0.92rem; line-height: 1.3; }

  .lab--l { gap: 14px 32px; }
  .lab--l li { font: italic var(--display-weight) 1.2rem/1.35 var(--font-display); color: var(--ink); }

  .lab--m { gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  .lab--m li { padding: 14px 16px; border-radius: var(--radius); background: var(--surface); border-top: 2px solid var(--peach); font-size: 0.95rem; line-height: 1.35; }

  .lab--n li { padding-left: 22px; }
  .lab--n li::before { content: ''; position: absolute; left: 3px; top: 0.6em; width: 6px; height: 6px; background: var(--peach); transform: rotate(45deg); }

  .lab--o li { padding-left: 22px; }
  .lab--o li::before { content: '+'; position: absolute; left: 1px; top: -0.05em; color: var(--peach); font-weight: 600; font-size: 1.15em; }
</style>
