---
// Grove intro: a bundle of muscle fibres starts knotted and ember-coloured, relaxes into calm
// sage waves as you scroll, then parts to reveal a dry needling session.
// Without JavaScript the final frame shows as a static banner; with reduced motion it is skipped.
import { href, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const L = (en: string, es: string) => (lang === 'es' ? es : en);
const FIBERS = 18;
---

<section class="gv-intro" data-gv-intro aria-label={L('Introduction', 'Introducción')}>
  <div class="gv-intro__stage" data-gv-stage>
    <img class="gv-intro__photo" data-gv-photo src="/images/services/dry-needling.webp" alt="" width="1280" height="853" fetchpriority="high" />
    <div class="gv-intro__shade" data-gv-shade></div>
    <svg class="gv-intro__fibers" viewBox="0 0 1440 820" preserveAspectRatio="none" aria-hidden="true">
      {Array.from({ length: FIBERS }, () => <path data-gv-fiber fill="none" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke" />)}
    </svg>
    <p class="gv-intro__line" data-gv-line1 aria-hidden="true">{L('Pain is tension ', 'El dolor es tensión ')}<em style="color: var(--ember);">{L('with nowhere to go.', 'sin salida.')}</em></p>
    <p class="gv-intro__line" data-gv-line2 aria-hidden="true">{L('We find the knot, ', 'Encontramos el nudo, ')}<em style="color: var(--accent);">{L('and let it go.', 'y lo soltamos.')}</em></p>
    <div class="gv-intro__final" data-gv-final>
      <p class="gv-intro__title">{L('Release the pain.', 'Suelta el dolor.')}<br /><em>{L('Keep the strength.', 'Conserva la fuerza.')}</em></p>
      <a class="btn btn--primary" href={href(lang, '/sign-up.html')}>{t(lang, 'cta.call')}</a>
    </div>
    <span class="gv-intro__hint" data-gv-hint aria-hidden="true">{L('Scroll to release', 'Desliza para soltar')}</span>
  </div>
</section>

<style is:global>
  .gv-intro {
    position: relative;
    height: 100svh;
    min-height: 520px;
    background: var(--bg);
    color: var(--ink);
  }

  .gv-intro__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 520px;
    overflow: hidden;
  }

  .gv-intro__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gv-intro__shade {
    position: absolute;
    inset: 0;
    background: rgb(12 14 13 / 60%);
  }

  .gv-intro__fibers {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .gv-intro.is-live .gv-intro__fibers {
    opacity: 1;
  }

  .gv-intro__line {
    position: absolute;
    left: clamp(20px, 4vw, 48px);
    right: clamp(20px, 4vw, 48px);
    bottom: 96px;
    max-width: 900px;
    margin: 0;
    font: 400 clamp(2.1rem, 6vw, 4rem) / 1.05 var(--font-display);
    text-shadow: 0 0 18px var(--bg), 0 0 6px var(--bg);
    opacity: 0;
  }

  .gv-intro__final {
    position: absolute;
    left: clamp(20px, 4vw, 48px);
    right: clamp(20px, 4vw, 48px);
    bottom: clamp(48px, 9vh, 80px);
  }

  .gv-intro__title {
    margin: 0 0 28px;
    font: 400 clamp(3rem, 9.5vw, 7.5rem) / 0.98 var(--font-display);
    letter-spacing: -0.02em;
  }

  .gv-intro__title em {
    color: var(--accent);
  }

  .gv-intro__hint {
    position: absolute;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #8a857a;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .gv-intro {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var intro = document.querySelector('[data-gv-intro]');
    if (!intro || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) return;

    var stage = intro.querySelector('[data-gv-stage]');
    var photo = intro.querySelector('[data-gv-photo]');
    var shade = intro.querySelector('[data-gv-shade]');
    var fibers = Array.prototype.slice.call(intro.querySelectorAll('[data-gv-fiber]'));
    var line1 = intro.querySelector('[data-gv-line1]');
    var line2 = intro.querySelector('[data-gv-line2]');
    var fin = intro.querySelector('[data-gv-final]');
    var hint = intro.querySelector('[data-gv-hint]');

    var styles = getComputedStyle(document.documentElement);
    var token = function (name, fallback) { return styles.getPropertyValue(name).trim() || fallback; };
    var rgb = function (h) { return [1, 3, 5].map(function (i) { return parseInt(h.substr(i, 2), 16); }); };
    var ember = rgb(token('--ember', '#e6814e')), sage = rgb(token('--accent', '#4ca239'));
    var mix = function (t) { return 'rgb(' + ember.map(function (v, i) { return Math.round(v + (sage[i] - v) * t); }).join(',') + ')'; };

    var clamp = function (v) { return Math.min(1, Math.max(0, v)); };
    var ease = function (t) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; };

    // Per-fibre noise is fixed, so the knot keeps its shape while it relaxes.
    var N = fibers.length, MID = 410;
    var noise = fibers.map(function (_, i) {
      var row = [];
      for (var x = 0; x <= 1440; x += 24) {
        var n = Math.sin((x + i * 97) * 12.9898) * 43758.5453;
        row.push(n - Math.floor(n) - 0.5);
      }
      return row;
    });

    var H = 0, W = 0, RUN = 2.5, raf = 0;

    // Keep the stage height steady while mobile toolbars show and hide; re-measure on rotation.
    function measure() {
      if (window.innerWidth === W && H) return;
      W = window.innerWidth;
      H = Math.max(520, window.innerHeight);
      // Screens of scrolling the animation takes; phones get a shorter run so each swipe moves it further.
      RUN = W < 768 ? 1.6 : 2.5;
      stage.style.height = H + 'px';
      intro.style.height = H * (RUN + 1) + 'px';
    }

    function frame() {
      raf = 0;
      measure();
      var p = clamp(-intro.getBoundingClientRect().top / (H * RUN));
      var seg = function (a, b) { return clamp((p - a) / (b - a)); };
      var bump = function (a, b, c, d) { return Math.min(seg(a, b), 1 - seg(c, d)); };

      // Knot at the centre -> calm parallel waves -> fibres part to reveal the photo.
      var relax = ease(seg(0.06, 0.6));
      var part = ease(seg(0.62, 0.84));
      var knot = 1 - relax;
      var colour = mix(relax);
      for (var i = 0; i < N; i++) {
        var base = 140 + i * (540 / (N - 1));
        var away = base < MID ? -1 : 1;
        var d = '';
        for (var j = 0, x = 0; x <= 1440; x += 24, j++) {
          var g = Math.exp(-Math.pow((x - 720) / 300, 2));
          var y = base + (MID - base) * 0.85 * g * knot;
          y += knot * g * (noise[i][j] * 70 + Math.sin(x * 0.045 + i * 1.7) * 38);
          y += relax * Math.sin(x * 0.006 + i * 0.35) * 10;
          y += away * part * (500 + Math.abs(base - MID));
          d += (x === 0 ? 'M' : 'L') + x + ' ' + y.toFixed(1);
        }
        fibers[i].setAttribute('d', d);
        fibers[i].setAttribute('stroke', colour);
        fibers[i].setAttribute('opacity', (0.85 * (1 - part)).toFixed(2));
      }

      var f = ease(seg(0.84, 0.96));
      photo.style.opacity = seg(0.6, 0.8).toFixed(3);
      photo.style.transform = 'scale(' + (1.1 - 0.1 * part).toFixed(3) + ')';
      shade.style.background = 'rgba(12,14,13,' + (0.3 + 0.3 * f).toFixed(2) + ')';
      line1.style.opacity = 1 - seg(0.24, 0.3);
      line2.style.opacity = bump(0.34, 0.4, 0.58, 0.64);
      fin.style.opacity = f;
      fin.style.transform = 'translateY(' + ((1 - f) * 40).toFixed(1) + 'px)';
      fin.style.pointerEvents = f > 0.5 ? 'auto' : 'none';
      hint.style.opacity = 1 - seg(0, 0.05);
    }

    function schedule() {
      if (!raf) raf = requestAnimationFrame(frame);
    }

    intro.classList.add('is-live');
    frame();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
  })();
</script>
