---
import reviews from '../data/reviews.json';
import { REVIEWS_URL } from '../data/googleRating';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// Reviews are quoted as written on Google, so they stay in their original language.
const clean = (text: string) => text.replace(/^"|"$/g, '');
// Patient names are not shown (privacy); `name` stays in the data only to find the review on Google.
const es = lang === 'es';
const withWhom: Record<string, { en: string; es: string }> = {
  'Dr. Leslie Garcia': { en: 'Dr. Leslie Garcia', es: 'la Dra. Leslie Garcia' },
  'Dr. Sandra Gomez': { en: 'Dr. Sandra Gomez', es: 'la Dra. Sandra Gomez' },
  'Powerhouse PT Team': { en: 'the Powerhouse PT team', es: 'el equipo de Powerhouse PT' },
};
const who = (provider: string) => withWhom[provider]?.[lang] ?? provider;
---

<div class="reviews" tabindex="0" role="region" aria-label={t(lang, 'home.reviewsTitle')}>
  {reviews.map((r) => (
    <figure class="review" style="margin: 0;">
      <span class="review__stars" aria-label="5/5">★★★★★</span>
      <span class="tag">{r.tag}</span>
      <blockquote class="review__text" style="margin: 0;" lang="en">{clean(r.text)}</blockquote>
      <figcaption class="review__meta"><strong>{es ? 'Reseña de Google' : 'Google review'}</strong> · {es ? 'Con' : 'With'} {who(r.provider)}</figcaption>
    </figure>
  ))}
</div>
<p style="margin-top: 20px;"><a class="link-arrow" href={REVIEWS_URL} target="_blank" rel="noopener">{t(lang, 'rating.readAll')}</a></p>
