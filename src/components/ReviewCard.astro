---
interface Props {
  name: string;
  date: string;
  tag: string;
  text: string;
  provider: string;
}

const { name, date, tag, text, provider } = Astro.props;
---

<div class="review-card">
  <div class="review-card__top">
    <div class="review-card__avatar">{name.charAt(0)}</div>
    <div class="review-card__meta">
      <span class="review-card__name">{name}</span>
      <span class="review-card__date">{date}</span>
    </div>
    <svg class="review-card__google-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="20" height="20"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.2l6.7-6.7C35.8 2.5 30.2 0 24 0 14.8 0 7 5.4 3 13.3l7.8 6C12.7 13.3 17.9 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h12.4c-.5 2.8-2.1 5.2-4.5 6.8l7 5.4c4.1-3.8 6.5-9.4 6.2-16.2z"/><path fill="#FBBC05" d="M10.8 28.7A14.5 14.5 0 0 1 9.5 24c0-1.6.3-3.2.8-4.7l-7.8-6A24 24 0 0 0 0 24c0 3.9.9 7.5 2.5 10.7l8.3-6z"/><path fill="#34A853" d="M24 48c6.2 0 11.4-2 15.2-5.5l-7-5.4c-2 1.4-4.6 2.2-8.2 2.2-6.1 0-11.3-3.8-13.2-9.2l-8.3 6C6.9 42.6 14.8 48 24 48z"/></svg>
  </div>
  <div class="review-card__stars">
    <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
  </div>
  <span class="review-card__tag">{tag}</span>
  <p class="review-card__text">{text}</p>
  <span class="review-card__provider">{provider}</span>
</div>
