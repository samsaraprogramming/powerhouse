---
// One team member: photo, name, role, expertise line and highlights. Links to the bio page.
import { href, type Lang } from '../i18n/ui';
import { responsive, sizes } from '../lib/images';
import type { getTeam } from '../lib/content';

interface Props {
  lang: Lang;
  member: ReturnType<typeof getTeam>[number];
}

const { lang, member: m } = Astro.props;
---

<a class="card team-card" href={href(lang, `/${m.slug}-bio.html`)}>
  <div class="card__media"><img {...responsive(m.photo)} sizes={sizes.team} alt={m.home.photoAlt} loading="lazy" width="400" height="500" /></div>
  <div class="card__body">
    <h3>{m.home.shortName}</h3>
    <span class="team-card__title">{m.home.role}</span>
    <p class="team-card__expertise">{m.home.expertise}</p>
    <ul class="list-credentials list-credentials--sm team-card__points">{m.home.points.map((p) => <li>{p}</li>)}</ul>
  </div>
</a>
