---
import ReviewCard from '../ReviewCard.astro';
import reviews from '../../data/reviews.json';
---

<section id="review">
  <div class="reviews-section">
    <div class="reviews-header" data-aos="fade-up">
      <p class="section-label">WHAT PATIENTS SAY</p>
      <h2 class="reviews-title">Real Results, Real Stories</h2>
      <div class="reviews-rating-summary">
        <div class="stars-row">
          <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
        </div>
        <span class="rating-text">5.0 · 118 Reviews on Google</span>
      </div>
    </div>

    <div class="reviews-carousel-wrapper" data-aos="fade-up" data-aos-delay="100">
      <button class="carousel-btn carousel-btn--prev" aria-label="Previous reviews">
        <i class="fa-solid fa-chevron-left"></i>
      </button>

      <div class="reviews-track-container">
        <div class="reviews-track" id="reviewsTrack">
          {reviews.map((review) => <ReviewCard {...review} />)}
        </div><!-- end reviews-track -->
      </div><!-- end reviews-track-container -->

      <button class="carousel-btn carousel-btn--next" aria-label="Next reviews">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div><!-- end reviews-carousel-wrapper -->

    <div class="reviews-dots" id="reviewsDots"></div>

    <div class="reviews-cta" data-aos="fade-up">
      <a href="https://www.google.com/search?hl=en-US&gl=us&q=Powerhouse+PT-+Physical+Therapy,+2446+San+Isidro+Pkwy,+Laredo,+TX+78045&ludocid=1487800702119469561#lrd=0x866121cdb1abf8e9:0x14a5badb1a6861f9,1,,,," target="_blank" rel="noopener" class="btn-reviews-cta">
        <svg class="btn-google-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="18" height="18"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.2l6.7-6.7C35.8 2.5 30.2 0 24 0 14.8 0 7 5.4 3 13.3l7.8 6C12.7 13.3 17.9 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h12.4c-.5 2.8-2.1 5.2-4.5 6.8l7 5.4c4.1-3.8 6.5-9.4 6.2-16.2z"/><path fill="#FBBC05" d="M10.8 28.7A14.5 14.5 0 0 1 9.5 24c0-1.6.3-3.2.8-4.7l-7.8-6A24 24 0 0 0 0 24c0 3.9.9 7.5 2.5 10.7l8.3-6z"/><path fill="#34A853" d="M24 48c6.2 0 11.4-2 15.2-5.5l-7-5.4c-2 1.4-4.6 2.2-8.2 2.2-6.1 0-11.3-3.8-13.2-9.2l-8.3 6C6.9 42.6 14.8 48 24 48z"/></svg>
        Read All Reviews on Google
      </a>
    </div>
  </div>

  <!-- Review Full-Text Modal -->
  <div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content review-modal-content">
        <div class="modal-header review-modal-header">
          <div class="review-modal-top">
            <div class="review-modal-avatar" id="reviewModalAvatar"></div>
            <div class="review-modal-meta">
              <span class="review-modal-name" id="reviewModalName"></span>
              <span class="review-modal-date" id="reviewModalDate"></span>
            </div>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body review-modal-body">
          <div class="review-modal-stars">
            <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
          </div>
          <span class="review-modal-tag" id="reviewModalTag"></span>
          <p class="review-modal-text" id="reviewModalText"></p>
          <span class="review-modal-provider" id="reviewModalProvider"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  const track = document.getElementById('reviewsTrack');
  const container = track ? track.parentElement : null;
  const dotsContainer = document.getElementById('reviewsDots');
  if (!track) return;

  const cards = Array.from(track.children);
  let perPage = getPerPage();
  let current = 0;
  let total = Math.ceil(cards.length / perPage);

  function isMobile() { return window.innerWidth <= 600; }

  function getPerPage() {
    if (window.innerWidth <= 600) return 1;
    if (window.innerWidth <= 991) return 2;
    return 3;
  }

  function getCardWidth() {
    return cards[0].getBoundingClientRect().width;
  }

  function getGap() {
    return parseFloat(getComputedStyle(track).gap) || 20;
  }

  function goTo(index) {
    current = ((index % total) + total) % total;
    if (isMobile()) {
      const cardWidth = getCardWidth();
      const gap = getGap();
      container.scrollTo({ left: current * (cardWidth + gap), behavior: 'smooth' });
    } else {
      const offset = current * perPage * (getCardWidth() + getGap());
      track.style.transform = `translateX(-${offset}px)`;
    }
    updateDots();
  }

  function buildDots() {
    dotsContainer.innerHTML = '';
    for (let i = 0; i < total; i++) {
      const btn = document.createElement('button');
      btn.className = 'dot' + (i === 0 ? ' active' : '');
      btn.setAttribute('aria-label', 'Go to page ' + (i + 1));
      btn.addEventListener('click', () => goTo(i));
      dotsContainer.appendChild(btn);
    }
  }

  function updateDots() {
    Array.from(dotsContainer.children).forEach((d, i) => {
      d.classList.toggle('active', i === current);
    });
  }

  const prevBtn = document.querySelector('.carousel-btn--prev');
  const nextBtn = document.querySelector('.carousel-btn--next');
  prevBtn.addEventListener('click', () => goTo(current - 1));
  nextBtn.addEventListener('click', () => goTo(current + 1));

  // Sync dots to native scroll position on mobile
  let rafPending = false;
  container.addEventListener('scroll', () => {
    if (!isMobile()) return;
    if (rafPending) return;
    rafPending = true;
    requestAnimationFrame(() => {
      const cardWidth = getCardWidth();
      const gap = getGap();
      current = Math.round(container.scrollLeft / (cardWidth + gap));
      updateDots();
      rafPending = false;
    });
  }, { passive: true });

  function init() {
    perPage = getPerPage();
    total = Math.ceil(cards.length / perPage);
    buildDots();
    current = 0;
    if (!isMobile()) {
      track.style.transform = 'translateX(0)';
    } else {
      container.scrollLeft = 0;
    }
    updateDots();
  }

  init();
  window.addEventListener('resize', init);

  // "Read more" modal
  const modal = document.getElementById('reviewModal');
  if (!modal) return;

  cards.forEach(card => {
    const textEl = card.querySelector('.review-card__text');
    if (!textEl) return;

    const wrapper = document.createElement('div');
    wrapper.className = 'review-card__text-wrapper';
    textEl.parentNode.insertBefore(wrapper, textEl);
    wrapper.appendChild(textEl);

    const btn = document.createElement('button');
    btn.className = 'review-card__read-more';
    btn.textContent = 'Read full review';
    btn.setAttribute('data-bs-toggle', 'modal');
    btn.setAttribute('data-bs-target', '#reviewModal');
    wrapper.after(btn);

    btn.addEventListener('click', () => {
      document.getElementById('reviewModalAvatar').textContent =
        card.querySelector('.review-card__avatar').textContent;
      document.getElementById('reviewModalName').textContent =
        card.querySelector('.review-card__name').textContent;
      document.getElementById('reviewModalDate').textContent =
        card.querySelector('.review-card__date').textContent;
      document.getElementById('reviewModalTag').textContent =
        card.querySelector('.review-card__tag').textContent;
      document.getElementById('reviewModalText').textContent =
        textEl.textContent;
      document.getElementById('reviewModalProvider').textContent =
        card.querySelector('.review-card__provider').textContent;
    });
  });
})();
</script>
