---
import type { team } from '../../data/team';

interface Props {
  member: (typeof team)[number];
}

const { member } = Astro.props;
const { home } = member;
---

<div class="about-team">
  <img class="profile-picture" src={member.photo} alt={home.photoAlt} data-aos="zoom-in" />
  <h2 class="profile-title" data-aos="fade-up" data-aos-delay="100" set:html={member.name} />
  <br />
  <div class="personal-summary-description">
    <p>{home.role}</p>
    <p>{home.expertise}</p>
    <br />
    <div class="personal-points-container">
      <ul class="personal-summary-points">
        {home.points.map((point) => <li class="personal-bullet-point">{point}</li>)}
      </ul>
    </div>
  </div>
</div>

<div class="accordion" id={home.accordionId}>
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button
        class="accordion-button collapsed"
        role="button"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target={`#${home.collapseId}`}
        aria-expanded="false"
        aria-controls={home.collapseId}
      >
        Learn More <span class="visually-hidden">about {home.shortName}</span>
      </button>
    </h2>
    <div id={home.collapseId} class="accordion-collapse collapse" data-bs-parent={`#${home.accordionId}`}>
      <div class="accordion-body profile-summary">
        <p>{home.teaser}</p>
        <a href={`/${member.slug}-bio.html`} class="read-bio-link">
          Read Full Bio<span class="visually-hidden"> of {home.shortName}</span> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </div>
</div>
