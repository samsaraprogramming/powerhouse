      <style is:inline>
        .line {
          fill: none;
          stroke-width: 1.5;
          mix-blend-mode: screen;
        }
        /* GPU-accelerated: only translate, no path morphing or blur */
        .l1 { animation: waveA 22s ease-in-out infinite; opacity: 0.6; }
        .l2 { animation: waveB 25s ease-in-out infinite; opacity: 0.5; }
        .l3 { animation: waveA 18s ease-in-out infinite; opacity: 0.55; }
