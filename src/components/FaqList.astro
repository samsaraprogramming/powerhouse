---
interface Props {
  items: { q: string; a: string }[];
  /** Open the first answer by default. */
  openFirst?: boolean;
}

const { items, openFirst = false } = Astro.props;
---

<div class="faq">
  {items.map((item, i) => (
    <details open={openFirst && i === 0}>
      <summary>{item.q}</summary>
      <div><p>{item.a}</p></div>
    </details>
  ))}
</div>
