---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import PatientQuote from '../components/PatientQuote.astro';
import { serviceQuotes } from '../data/quotes';
import { href, t, type Lang } from '../i18n/ui';
import { getService, plain } from '../lib/content';
import { conditions } from '../data/conditions';
import { breadcrumbNode, pageNode, therapyNode } from '../lib/schema';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const s = getService(slug, lang);
const path = href(lang, `/service-${slug}.html`);
const name = plain(s.heroTitle);
const related = conditions.filter((c) => c.services.includes(slug));

const schema = [
  pageNode({ type: 'MedicalWebPage', path, name: s.metaTitle, description: s.metaDescription, lang, about: therapyNode(s, path) }),
  breadcrumbNode([
    { name: t(lang, 'breadcrumb.home'), path: href(lang, '/') },
    { name: t(lang, 'nav.care'), path: href(lang, '/services.html') },
    { name, path },
  ]),
];
---

<BaseLayout title={s.metaTitle} description={s.metaDescription} schema={schema} image={s.heroImage}>
  <PageHero
    lang={lang}
    crumbs={[{ name: t(lang, 'nav.care'), path: '/services.html' }, { name, path: `/service-${slug}.html` }]}
    title={s.heroTitle}
    lead={s.heroSubtitle}
    image={{ src: s.heroImage, alt: s.heroAlt }}
  >
    <div class="btn-row" style="margin-top: 28px;">
      <a class="btn btn--primary" href={href(lang, '/sign-up.html')}>{t(lang, 'cta.call')}</a>
    </div>
  </PageHero>

  <section class="section section--tight">
    <div class="wrap wrap--narrow">
      <p class="lead" style="color: var(--ink);" set:html={s.intro} />
      {serviceQuotes[slug] && <PatientQuote lang={lang} variant="hang" quote={serviceQuotes[slug]} />}
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap two-col">
      <div>
        <h2 set:html={s.conditionsHeading} />
      </div>
      <ul class="list-serif">
        {s.conditions.map((c) => <li set:html={c} />)}
      </ul>
    </div>
    <div class="wrap section-foot">
      <RelatedLinks
        label={lang === 'es' ? 'Guías relacionadas' : 'Related guides'}
        links={related.map((c) => ({ href: href(lang, `/conditions/${c.slug}.html`), html: c.name[lang] }))}
      />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead title={s.detailsHeading} />
      <div class="grid" style="--min: 280px;">
        {s.details.map((d) => (
          <div class="card">
            <div class="card__body">
              <h3 set:html={d.title} />
              <p set:html={d.text} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ProcessSteps heading={s.processHeading} steps={s.steps} />

  <CtaBand lang={lang} title={s.ctaHeading} text={s.ctaSubtext} />
</BaseLayout>
