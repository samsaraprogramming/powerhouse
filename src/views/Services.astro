---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaCard from '../components/MediaCard.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { href, t, type Lang } from '../i18n/ui';
import { getServices, plain } from '../lib/content';
import { breadcrumbNode, pageNode, therapyNode } from '../lib/schema';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const L = (en: string, es: string) => (lang === 'es' ? es : en);
const path = href(lang, '/services.html');
const title = L('Physical Therapy Services in Laredo, TX | Powerhouse PT', 'Servicios de terapia física en Laredo, TX | Powerhouse PT');
const description = L(
  'Orthopedic physical therapy, sports performance, running analysis, dry needling, cupping and blood flow restriction (BFR) training in Laredo, Texas. One-on-one care with licensed physical therapists.',
  'Terapia física ortopédica, rendimiento deportivo, análisis de carrera, punción seca, ventosas y entrenamiento con restricción del flujo sanguíneo (BFR) en Laredo, Texas. Atención uno a uno con fisioterapeutas con licencia.',
);
const services = getServices(lang);
const crumbs = [{ name: t(lang, 'nav.care'), path: '/services.html' }];

const schema = [
  pageNode({ type: 'CollectionPage', path, name: title, description, lang }),
  breadcrumbNode([{ name: t(lang, 'breadcrumb.home'), path: href(lang, '/') }, { name: t(lang, 'nav.care'), path }]),
  ...services.map((s) => therapyNode(s, href(lang, `/service-${s.slug}.html`))),
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero lang={lang} crumbs={crumbs} title={t(lang, 'home.servicesTitle')} lead={t(lang, 'home.servicesLead')} />

  <section class="section section--tight">
    <div class="wrap grid" style="--min: 320px;">
      {services.map((s) => (
        <MediaCard heading="h2" href={href(lang, `/service-${s.slug}.html`)} image={s.heroImage} title={plain(s.heroTitle)} text={s.heroSubtitle} linkLabel={t(lang, 'cta.learnMore')} />
      ))}
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
