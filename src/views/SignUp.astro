---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Visit from '../components/Visit.astro';
import { href, t, type Lang } from '../i18n/ui';
import { clinic, booking } from '../data/clinic';
import { breadcrumbNode, pageNode, CLINIC_ID } from '../lib/schema';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const L = (en: string, es: string) => (lang === 'es' ? es : en);
const path = href(lang, '/sign-up.html');
const title = L('Schedule a Free Discovery Call | Powerhouse PT Laredo', 'Agenda una llamada gratuita | Powerhouse PT Laredo');
const description = L(
  `Tell us about your pain and goals and we'll call you ${booking.responseTime.en} to schedule. Physical therapy in Laredo, TX.`,
  `Cuéntanos sobre tu dolor y tus metas y te llamaremos ${booking.responseTime.es} para agendar. Terapia física en Laredo, TX.`,
);

// The submitted values stay in English so the clinic's notification emails read the same.
const insuranceOptions = [
  ['None', L('None', 'Ninguno')],
  ['Aetna', 'Aetna'],
  ['Blue Cross Blue Shield', 'Blue Cross Blue Shield'],
  ['Cigna', 'Cigna'],
  ['Humana', 'Humana'],
  ['Medicare', 'Medicare'],
  ['Medicaid', 'Medicaid'],
  ['Tricare', 'Tricare'],
  ['UnitedHealthcare', 'UnitedHealthcare'],
  ["Workers' compensation", L("Workers' compensation", 'Compensación laboral')],
  ['Other', L('Other', 'Otro')],
];

const messages = {
  firstName: L('Please enter your first name.', 'Escribe tu nombre.'),
  lastName: L('Please enter your last name.', 'Escribe tu apellido.'),
  nameBad: L('Please use letters only.', 'Usa solo letras.'),
  goalLink: L('Please remove links or web addresses.', 'Quita los enlaces o direcciones web.'),
  suggestBefore: L('Did you mean', '¿Quisiste decir'),
  suggestAfter: '?',
  phoneEmpty: L('Please enter your phone number.', 'Escribe tu número de teléfono.'),
  phoneBad: L('Please enter a valid phone number, including country code if outside the US.', 'Escribe un teléfono válido, con código de país si no es de EE. UU.'),
  emailEmpty: L('Please enter your email address.', 'Escribe tu correo electrónico.'),
  emailBad: L('Please enter a valid email address, like name@example.com.', 'Escribe un correo válido, por ejemplo nombre@ejemplo.com.'),
  insurance: L('Please select your insurance provider.', 'Selecciona tu seguro.'),
  goal: L('Please enter your goal.', 'Cuéntanos tu meta.'),
  send: L('Send', 'Enviar'),
  sending: L('Sending…', 'Enviando…'),
};

const schema = [
  pageNode({ type: 'ContactPage', path, name: title, description, lang, about: { '@id': CLINIC_ID } }),
  breadcrumbNode([{ name: t(lang, 'breadcrumb.home'), path: href(lang, '/') }, { name: t(lang, 'cta.call'), path }]),
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    lang={lang}
    crumbs={[{ name: t(lang, 'cta.call'), path: '/sign-up.html' }]}
    title={L('Schedule a free discovery call', 'Agenda una llamada gratuita')}
    lead={L(
      `Tell us a little about what's going on. We'll call you ${booking.responseTime.en} for a free ${booking.discoveryCallMinutes}-minute conversation, with no pressure and no commitment.`,
      `Cuéntanos un poco qué está pasando. Te llamaremos ${booking.responseTime.es} para una conversación gratuita de ${booking.discoveryCallMinutes} minutos, sin presión y sin compromiso.`,
    )}
  />

  <section class="section section--tight">
    <div class="wrap two-col">
      <form id="contact-form" class="form" novalidate>
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="elapsed" id="elapsed" value="" />
        {/* Honeypot: off-screen and skipped by keyboard and screen readers. People leave it empty; bots fill it in. */}
        <div aria-hidden="true" style="position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden;">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div>
          <label for="firstName">{L('First name', 'Nombre')}</label>
          <input id="firstName" name="first_name" type="text" autocomplete="given-name" maxlength="50" required />
          <div class="feedback" id="firstName-feedback"></div>
        </div>
        <div>
          <label for="lastName">{L('Last name', 'Apellido')}</label>
          <input id="lastName" name="last_name" type="text" autocomplete="family-name" maxlength="50" required />
          <div class="feedback" id="lastName-feedback"></div>
        </div>
        <div class="full">
          <label for="phone">{L('Phone number', 'Teléfono')}</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="25" required />
          <div class="feedback" id="phone-feedback"></div>
        </div>
        <div class="full">
          <label for="email">{L('Email', 'Correo electrónico')}</label>
          <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
          <div class="feedback" id="email-feedback"></div>
          <div class="form-suggest" id="email-suggest" aria-live="polite"></div>
        </div>
        <div class="full">
          <label for="insurance">{L('Insurance provider', 'Seguro médico')}</label>
          <select id="insurance" name="insurance" required>
            <option value="" disabled selected>{L('Select your insurance provider', 'Selecciona tu seguro')}</option>
            {insuranceOptions.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
          <div class="feedback" id="insurance-feedback"></div>
        </div>
        <div class="full">
          <label for="goal">{L("What's your goal?", '¿Cuál es tu meta?')}</label>
          <textarea id="goal" name="goal" rows="4" maxlength="1000" required></textarea>
          <p class="form-hint" id="goal-hint">
            {L(
              "A short summary is enough. Please don't include medications, test results or insurance numbers; we'll go over the details on the phone.",
              'Con un breve resumen basta. Por favor no incluyas medicamentos, resultados de estudios ni números de seguro; revisaremos los detalles por teléfono.',
            )}
          </p>
          <div class="feedback" id="goal-feedback"></div>
        </div>
        <div class="full">
          <button class="btn btn--primary" type="submit" id="submit-btn" style="width: 100%;">{messages.send}</button>
        </div>
        <div class="full form-status form-status--ok" id="form-success" role="status" hidden>
          {L("Message sent! We'll be in touch shortly.", '¡Mensaje enviado! Te contactaremos pronto.')}
        </div>
        <div class="full form-status form-status--error" id="form-error" role="alert" hidden>
          {L('Something went wrong. Please try again, or call or text us at', 'Algo salió mal. Intenta de nuevo, o llámanos o escríbenos al')} <a href={`tel:${clinic.phoneE164}`}>{clinic.phone}</a>.
        </div>
      </form>

      <div>
        <h2 style="font-size: 1.6rem;">{L('Prefer to call?', '¿Prefieres llamar?')}</h2>
        <Visit lang={lang} />
      </div>
    </div>
  </section>

  <script is:inline slot="scripts" define:vars={{ messages }}>
    // Each validator returns an error message, or "" when the value is fine.
    // Same rules as netlify/functions/contact.mjs, which re-checks on the server.
    var required = function (message) {
      return function (value) { return value.trim() ? '' : message; };
    };

    // Same patterns as NAME_RE and LINK_RE in the function.
    var NAME_RE = /^[\p{L}\p{M}' .-]+$/u;
    var LINK_RE = /(\b[a-z][a-z0-9+.-]*:\/\/|\bwww\.|<\s*[a-z!\/]|\[\s*\/?\s*(url|link)\b|\b[a-z0-9-]+\.(com|net|org|info|biz|io|co|me|ly|us|ru|cn|xyz|top|site|online|click|link|app|shop|store|live|win|vip|bet|loan)\b)/i;
    var name = function (message) {
      return function (value) {
        var v = value.trim();
        if (!v) return message;
        return NAME_RE.test(v) ? '' : messages.nameBad;
      };
    };

    var validators = {
      firstName: name(messages.firstName),
      lastName: name(messages.lastName),
      phone: function (value) {
        var phone = value.trim();
        if (!phone) return messages.phoneEmpty;
        var digits = phone.replace(/\D/g, '');
        if (!/^\+?[\d\s().-]+$/.test(phone) || digits.length < 7 || digits.length > 15) return messages.phoneBad;
        return '';
      },
      email: function (value) {
        var email = value.trim();
        if (!email) return messages.emailEmpty;
        if (!/^[^\s@]+@[^\s@.]+(\.[^\s@.]+)+$/.test(email)) return messages.emailBad;
        return '';
      },
      insurance: function (value) { return value ? '' : messages.insurance; },
      goal: function (value) {
        var v = value.trim();
        if (!v) return messages.goal;
        return LINK_RE.test(v) ? messages.goalLink : '';
      },
    };

    // Typo hint for the email domain ("gmial.com" -> "Did you mean ...@gmail.com?"). The domain is compared
    // with common providers by edit distance, counting a swap of two neighbouring letters as one edit; one
    // edit is allowed for short domains and two for longer ones. It only suggests; nothing changes unless tapped.
    var DOMAINS = [
      'gmail.com', 'googlemail.com', 'yahoo.com', 'ymail.com', 'yahoo.com.mx', 'hotmail.com', 'hotmail.es',
      'outlook.com', 'outlook.es', 'live.com', 'live.com.mx', 'msn.com', 'icloud.com', 'me.com', 'mac.com',
      'aol.com', 'att.net', 'sbcglobal.net', 'bellsouth.net', 'comcast.net', 'verizon.net', 'charter.net',
      'cox.net', 'proton.me', 'protonmail.com', 'gmx.com', 'mail.com', 'prodigy.net.mx',
    ];

    function editDistance(a, b) {
      var d = [];
      for (var i = 0; i <= a.length; i++) { d[i] = [i]; }
      for (var j = 0; j <= b.length; j++) { d[0][j] = j; }
      for (i = 1; i <= a.length; i++) {
        for (j = 1; j <= b.length; j++) {
          var cost = a[i - 1] === b[j - 1] ? 0 : 1;
          d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + cost);
          if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) {
            d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);
          }
        }
      }
      return d[a.length][b.length];
    }

    function suggestEmail(value) {
      var email = value.trim();
      var at = email.lastIndexOf('@');
      if (at < 1) return '';
      var domain = email.slice(at + 1).toLowerCase();
      if (!domain || DOMAINS.indexOf(domain) !== -1) return '';
      var best = '';
      var bestDistance = Infinity;
      DOMAINS.forEach(function (candidate) {
        var distance = editDistance(domain, candidate);
        if (distance < bestDistance) { best = candidate; bestDistance = distance; }
      });
      var allowed = domain.length <= 8 ? 1 : 2;
      return bestDistance <= allowed ? email.slice(0, at + 1) + best : '';
    }

    var emailField = document.getElementById('email');
    var emailSuggest = document.getElementById('email-suggest');

    function showEmailSuggestion() {
      var suggestion = suggestEmail(emailField.value);
      emailSuggest.textContent = '';
      if (!suggestion) return;
      var button = document.createElement('button');
      button.type = 'button';
      button.textContent = suggestion;
      button.addEventListener('click', function () {
        emailField.value = suggestion;
        emailSuggest.textContent = '';
        validateField('email');
        emailField.focus();
      });
      emailSuggest.append(messages.suggestBefore + ' ', button, messages.suggestAfter);
    }

    emailField.addEventListener('blur', showEmailSuggestion);
    emailField.addEventListener('input', function () { emailSuggest.textContent = ''; });

    function validateField(id) {
      var field = document.getElementById(id);
      var message = validators[id](field.value);
      field.classList.toggle('is-invalid', Boolean(message));
      field.setAttribute('aria-invalid', message ? 'true' : 'false');
      document.getElementById(id + '-feedback').textContent = message;
      return !message;
    }

    Object.keys(validators).forEach(function (id) {
      var field = document.getElementById(id);
      var hint = document.getElementById(id + '-hint');
      field.setAttribute('aria-describedby', (hint ? hint.id + ' ' : '') + id + '-feedback');
      field.addEventListener('blur', function () { validateField(id); });
      field.addEventListener('input', function () {
        if (field.classList.contains('is-invalid')) validateField(id);
      });
    });

    // How long the form was open before sending; the server drops anything sent faster than a person could type.
    var openedAt = Date.now();

    document.getElementById('contact-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var form = this;
      var invalid = Object.keys(validators).filter(function (id) { return !validateField(id); });
      if (invalid.length) {
        document.getElementById(invalid[0]).focus();
        return;
      }

      var btn = document.getElementById('submit-btn');
      var success = document.getElementById('form-success');
      var error = document.getElementById('form-error');
      document.getElementById('elapsed').value = String(Date.now() - openedAt);
      btn.disabled = true;
      btn.textContent = messages.sending;
      success.hidden = true;
      error.hidden = true;

      fetch('/api/contact', { method: 'POST', body: new FormData(form) })
        .then(function (response) {
          if (!response.ok) throw new Error('Network response was not ok');
          return response.json();
        })
        .then(function (data) {
          if (data.status !== 'success') throw new Error(data.message || 'Unknown error');
          success.hidden = false;
          form.reset();
          emailSuggest.textContent = '';
          openedAt = Date.now();
        })
        .catch(function (err) {
          error.hidden = false;
          console.error('Submission error:', err);
        })
        .finally(function () {
          btn.disabled = false;
          btn.textContent = messages.send;
        });
    });
  </script>
</BaseLayout>
