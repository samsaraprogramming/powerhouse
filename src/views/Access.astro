---
import BaseLayout from '../layouts/BaseLayout.astro';
import PillList from '../components/PillList.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { href, t, type Lang } from '../i18n/ui';
import { directAccess, insurance, selfPay } from '../data/clinic';
import { faqGroups } from '../data/faq';
import { breadcrumbNode, faqNode, pageNode } from '../lib/schema';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const L = (en: string, es: string) => (lang === 'es' ? es : en);
const path = href(lang, '/access.html');
const title = L('Insurance, Self-Pay & Direct Access | Powerhouse PT Laredo', 'Seguros, pago sin seguro y acceso directo | Powerhouse PT Laredo');
const description = L(
  `Insurance we accept, self-pay, HSA/FSA, and how to see a physical therapist in Texas without a referral for up to ${directAccess.days} consecutive calendar days.`,
  `Seguros que aceptamos, pago sin seguro, HSA/FSA, y cómo ver a un fisioterapeuta en Texas sin referencia hasta por ${directAccess.days} días naturales consecutivos.`,
);


const faqs = faqGroups.find((g) => g.id === 'insurance-cost')!.items.map((i) => ({ q: i.q[lang], a: i.a[lang] }));

const schema = [
  pageNode({ path, name: title, description, lang }),
  faqNode(faqs),
  breadcrumbNode([{ name: t(lang, 'breadcrumb.home'), path: href(lang, '/') }, { name: t(lang, 'nav.access'), path }]),
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero lang={lang} crumbs={[{ name: t(lang, 'nav.access'), path: '/access.html' }]} title={t(lang, 'access.title')} lead={L('Everything you need to know before your first visit: referrals, insurance and paying.', 'Todo lo que necesitas saber antes de tu primera visita: referencias, seguros y formas de pago.')} />

  <section class="section section--tight" id="direct-access">
    <div class="wrap two-col">
      <div>
        <h2>{L('Do I need a referral?', '¿Necesito una referencia?')}</h2>
        <p class="lead">
          {L(
            `No, not to get started. Texas law lets you see a physical therapist directly for up to ${directAccess.days} consecutive calendar days. If you need care beyond that, or your insurance plan requires a referral, we coordinate with your doctor for you.`,
            `No, no para empezar. La ley de Texas te permite ver a un fisioterapeuta directamente hasta por ${directAccess.days} días naturales consecutivos. Si necesitas más tiempo o tu seguro pide una referencia, nosotros coordinamos con tu médico.`,
          )}
        </p>
        <p><a href={href(lang, '/direct-access.html')}>{L('How direct access works in Texas, and what changed in 2025', 'Cómo funciona el acceso directo en Texas y qué cambió en 2025')}</a></p>
      </div>
      <div class="callout">
        <h3>{L('What to bring to your first visit', 'Qué traer a tu primera visita')}</h3>
        <ul class="list-check" style="margin: 0;">
          <li>{L('Photo ID and insurance card', 'Identificación con foto y tarjeta del seguro')}</li>
          <li>{L('Any imaging reports or surgical protocols', 'Reportes de estudios de imagen o protocolos de cirugía')}</li>
          <li>{L('A list of your current medications', 'Lista de tus medicamentos actuales')}</li>
          <li>{L('Comfortable clothes you can move in', 'Ropa cómoda para moverte')}</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="insurance">
    <div class="wrap two-col">
      <div>
        <h2>{L('Insurance we accept', 'Seguros que aceptamos')}</h2>
        <p class="lead">{insurance.summary[lang]} {L('Coverage varies by plan, so we verify your benefits before your first visit. Not sure about yours? Call or text us and we will check.', 'La cobertura depende de tu plan, así que verificamos tus beneficios antes de tu primera visita. ¿No sabes si el tuyo aplica? Llámanos o escríbenos y lo revisamos.')}</p>
      </div>
      <PillList items={insurance.accepted.map((i) => i[lang])} />
    </div>
  </section>

  <section class="section" id="self-pay">
    <div class="wrap two-col">
      <div>
        <h2>{L('No insurance? Self-pay is available', '¿Sin seguro? Puedes pagar por tu cuenta')}</h2>
      </div>
      <div>
        <p class="lead">{selfPay[lang]}</p>
        {insurance.hsaFsa && <p>{L('HSA and FSA cards are welcome.', 'Aceptamos tarjetas HSA y FSA.')}</p>}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap two-col">
      <h2>{L('Questions about cost', 'Preguntas sobre costos')}</h2>
      <FaqList items={faqs} />
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
