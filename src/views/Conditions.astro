---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaCard from '../components/MediaCard.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { href, t, type Lang } from '../i18n/ui';
import { conditions } from '../data/conditions';
import { breadcrumbNode, pageNode, abs } from '../lib/schema';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const L = (en: string, es: string) => (lang === 'es' ? es : en);
const path = href(lang, '/conditions.html');
const title = L('Conditions We Treat | Physical Therapy in Laredo, TX | Powerhouse PT', 'Condiciones que tratamos | Terapia física en Laredo, TX | Powerhouse PT');
const description = L(
  'Back pain, sciatica, neck pain, headaches, shoulder, elbow, hip, knee, foot and ankle pain, ACL tears, running injuries, hamstring and groin strains, sports injuries and post-surgical rehab. Causes, treatment and when to get help.',
  'Dolor de espalda, ciática, cuello, dolores de cabeza, hombro, codo, cadera, rodilla, pie y tobillo, lesiones de LCA, lesiones al correr, desgarres de isquiotibiales e ingle, lesiones deportivas y rehabilitación postquirúrgica. Causas, tratamiento y cuándo buscar ayuda.',
);

const schema = [
  pageNode({
    type: 'CollectionPage',
    path,
    name: title,
    description,
    lang,
    extra: {
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: conditions.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name[lang], url: abs(href(lang, `/conditions/${c.slug}.html`)) })),
      },
    },
  }),
  breadcrumbNode([{ name: t(lang, 'breadcrumb.home'), path: href(lang, '/') }, { name: t(lang, 'nav.conditions'), path }]),
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero lang={lang} crumbs={[{ name: t(lang, 'nav.conditions'), path: '/conditions.html' }]} title={t(lang, 'conditions.title')} lead={t(lang, 'home.conditionsLead')} />

  <section class="section section--tight">
    <div class="wrap grid" style="--min: 300px;">
      {conditions.map((c) => (
        <MediaCard heading="h2" href={href(lang, `/conditions/${c.slug}.html`)} image={c.image} title={c.name[lang]} text={c.summary[lang]} linkLabel={t(lang, 'cta.readMore')} />
      ))}
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
