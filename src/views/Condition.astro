---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ReviewedBy from '../components/ReviewedBy.astro';
import Sources from '../components/Sources.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import PatientQuote from '../components/PatientQuote.astro';
import { conditionQuotes } from '../data/quotes';
import { href, t, type Lang } from '../i18n/ui';
import { conditionBySlug } from '../data/conditions';
import { posts } from '../data/posts';
import { booking } from '../data/clinic';
import { getService, plain } from '../lib/content';
import { breadcrumbNode, conditionNode, faqNode, pageNode, reviewerNode } from '../lib/schema';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const c = conditionBySlug(slug)!;
const L = (en: string, es: string) => (lang === 'es' ? es : en);
const path = href(lang, `/conditions/${slug}.html`);
const name = c.name[lang];
const title = L(`${name}: causes, treatment & when to get help | Powerhouse PT Laredo`, `${name}: causas, tratamiento y cuándo buscar ayuda | Powerhouse PT Laredo`);
const description = `${c.summary[lang]} ${L('Physical therapy in Laredo, TX.', 'Terapia física en Laredo, TX.')}`;
const faqs = c.faqs[lang];
const related = c.services.map((s) => getService(s, lang));
const articles = posts.filter((p) => p.conditions.includes(slug));

const schema = [
  pageNode({ type: 'MedicalWebPage', path, name: title, description, lang, reviewer: c.reviewer, lastReviewed: c.lastReviewed, about: conditionNode(c, lang), extra: { audience: { '@type': 'Patient' } } }),
  reviewerNode(c.reviewer, lang),
  faqNode(faqs),
  breadcrumbNode([
    { name: t(lang, 'breadcrumb.home'), path: href(lang, '/') },
    { name: t(lang, 'nav.conditions'), path: href(lang, '/conditions.html') },
    { name, path },
  ]),
];
---

<BaseLayout title={title} description={description} schema={schema} image={c.image}>
  <PageHero
    lang={lang}
    crumbs={[{ name: t(lang, 'nav.conditions'), path: '/conditions.html' }, { name, path: `/conditions/${slug}.html` }]}
    title={name}
    lead={c.summary[lang]}
    image={{ src: c.image }}
  >
    <ReviewedBy lang={lang} reviewer={c.reviewer} date={c.lastReviewed} />
  </PageHero>

  <section class="section section--tight">
    <div class="wrap two-col">
      <article class="prose">
        <p class="lead" style="color: var(--ink);">{c.intro[lang]}</p>

        <div class="cond-pair">
          <div>
            <h2>{L(`What does ${name.toLowerCase()} feel like?`, `¿Cómo se siente?`)}</h2>
            <ul class="cond-list">{c.symptoms[lang].map((s) => <li>{s}</li>)}</ul>
          </div>
          <div>
            <h2>{L('What usually causes it?', '¿Qué lo causa normalmente?')}</h2>
            <ul class="cond-list cond-list--causes">{c.causes[lang].map((s) => <li>{s}</li>)}</ul>
          </div>
        </div>

        <h2>{L('How can physical therapy help?', '¿Cómo puede ayudar la terapia física?')}</h2>
        <ul class="cond-list cond-list--help">{c.treatment[lang].map((s) => <li>{s}</li>)}</ul>
        {conditionQuotes[slug] && <PatientQuote lang={lang} variant="turn" quote={conditionQuotes[slug]} />}

        <h2>{L('When should I get it checked?', '¿Cuándo debo revisarlo?')}</h2>
        <p>{c.whenToSeek[lang]}</p>

        <div class="callout callout--warn">
          <h3>{L('See a doctor right away if you notice', 'Ve al médico de inmediato si notas')}</h3>
          <ul class="list-check list-flag" style="margin: 0;">{c.redFlags[lang].map((s) => <li>{s}</li>)}</ul>
        </div>

        <h2>{t(lang, 'conditions.faq')} {name.toLowerCase()}</h2>
        <FaqList items={faqs} />

        <Sources lang={lang} sources={c.sources} />
      </article>

      <aside style="display: grid; gap: 20px; align-content: start;">
        <div class="callout">
          <RelatedLinks
            layout="stack"
            label={t(lang, 'conditions.related')}
            links={related.map((s) => ({ href: href(lang, `/service-${s.slug}.html`), html: plain(s.heroTitle) }))}
          />
        </div>
        {articles.length > 0 && (
          <div class="callout">
            <RelatedLinks
              layout="stack"
              label={t(lang, 'library.title')}
              links={articles.map((p) => ({ href: href(lang, `/library/${p.slug}.html`), html: p.title[lang] }))}
            />
          </div>
        )}
        <div class="callout section--dark" style="border: 0;">
          <h2 style="font-size: 1.25rem;">{L('Not sure where to start?', '¿No sabes por dónde empezar?')}</h2>
          <p style="color: var(--ink-2);">{L(`A free ${booking.discoveryCallMinutes}-minute call is the easiest first step.`, `Una llamada gratuita de ${booking.discoveryCallMinutes} minutos es el primer paso más fácil.`)}</p>
          <a class="btn btn--primary" href={href(lang, '/sign-up.html')}>{t(lang, 'cta.call')}</a>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
