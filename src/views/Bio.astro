---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import CtaBand from '../components/CtaBand.astro';
import PatientQuote from '../components/PatientQuote.astro';
import { bioQuotes } from '../data/quotes';
import { href, t, type Lang } from '../i18n/ui';
import { getMember, plain } from '../lib/content';
import { conditions } from '../data/conditions';
import { posts } from '../data/posts';
import { breadcrumbNode, pageNode, personNode } from '../lib/schema';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const m = getMember(slug, lang);
const path = href(lang, `/${slug}-bio.html`);
const reviewed = conditions.filter((c) => c.reviewed && c.reviewer === slug);
const written = posts.filter((p) => p.reviewed && p.reviewer === slug);
const name = plain(m.name);

const schema = [
  pageNode({ type: 'ProfilePage', path, name: m.metaTitle, description: m.metaDescription, lang, extra: { mainEntity: { '@id': personNode(m, lang)['@id'] } } }),
  personNode(m, lang),
  breadcrumbNode([
    { name: t(lang, 'breadcrumb.home'), path: href(lang, '/') },
    { name: t(lang, 'nav.about'), path: href(lang, '/about.html') },
    { name, path },
  ]),
];
---

<BaseLayout title={m.metaTitle} description={m.metaDescription} schema={schema} image={m.photo}>
  <PageHero
    lang={lang}
    crumbs={[{ name: t(lang, 'nav.about'), path: '/about.html' }, { name, path: `/${slug}-bio.html` }]}
    title={m.name}
    lead={m.title}
    image={{ src: m.photo, alt: m.photoAlt, width: 640, height: 800, portrait: true }}
  >
    <ul class="list-credentials" style="margin-top: 28px;">
      {m.home.points.map((p) => <li>{p}</li>)}
    </ul>
  </PageHero>

  <section class="section section--tight">
    <div class="wrap two-col">
      <div class="prose">
        {m.paragraphs.map((p) => <p set:html={p} />)}
        {bioQuotes[slug] && <PatientQuote lang={lang} variant="hang" quote={bioQuotes[slug]} />}
      </div>
      {(reviewed.length > 0 || written.length > 0) && (
        <aside class="callout" style="align-self: start;">
          <RelatedLinks
            layout="stack"
            label={lang === 'es' ? 'Contenido revisado' : 'Clinical content reviewed'}
            links={[
              ...reviewed.map((c) => ({ href: href(lang, `/conditions/${c.slug}.html`), html: c.name[lang] })),
              ...written.map((p) => ({ href: href(lang, `/library/${p.slug}.html`), html: p.title[lang] })),
            ]}
          />
        </aside>
      )}
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
