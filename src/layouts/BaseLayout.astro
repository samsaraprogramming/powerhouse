---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  /** Lato axis list for the Google Fonts URL; each page type loads the weights it always has. */
  fonts?: string;
  /** Home and sign-up also load boxicons and AOS scroll animations. */
  aos?: boolean;
  isHome?: boolean;
  mainClass?: string;
}

const {
  title,
  description,
  keywords,
  fonts = 'ital,wght@0,400;0,700;0,900;1,400',
  aos = false,
  isHome = false,
  mainClass,
} = Astro.props;

const canonical = new URL(Astro.url.pathname === '/index.html' ? '/' : Astro.url.pathname, Astro.site);

// Structured data for local search results, emitted on the home page.
const clinic = {
  '@context': 'https://schema.org',
  '@type': 'PhysicalTherapy',
  name: 'Powerhouse PT - Physical Therapy',
  url: Astro.site,
  image: new URL('/images/powerhouse-logo.webp', Astro.site),
  telephone: '+1-956-307-6305',
  faxNumber: '+1-956-857-3229',
  email: 'info@powerhousesportspt.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '2446 San Isidro Pkwy',
    addressLocality: 'Laredo',
    addressRegion: 'TX',
    postalCode: '78045',
    addressCountry: 'US',
  },
  hasMap: 'https://maps.app.goo.gl/yDw3U9cw4icQMNew6',
  sameAs: [
    'https://www.instagram.com/powerhousept_',
    'https://www.facebook.com/people/Powerhouse-PT-Physical-Therapy/100094690571519/',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}

    {aos && <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />}
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    {aos && <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />}

    <!-- Font Awesome -->
    <script is:inline src="https://kit.fontawesome.com/46031f3086.js" crossorigin="anonymous"></script>
    <slot name="head" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {isHome && <script is:inline type="application/ld+json" set:html={JSON.stringify(clinic)} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={`https://fonts.googleapis.com/css2?family=Lato:${fonts}&display=swap`} rel="stylesheet" />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"></script>
    <script is:inline>
      var prevScroll = 0;

      window.addEventListener('scroll', function () {
        var scroll = window.scrollY;
        var navbar = document.querySelector('.navbar');
        if (!navbar) return;

        if (scroll < 50) {
          navbar.classList.remove('navbar-hide');
        } else if (scroll - prevScroll >= 20) {
          navbar.classList.add('navbar-hide');
          prevScroll = scroll;
        } else if (prevScroll - scroll >= 20) {
          navbar.classList.remove('navbar-hide');
          prevScroll = scroll;
        }
      });
    </script>
    {aos && (
      <Fragment>
        <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
        <script is:inline>
          AOS.init({
            duration: 750,
            once: true,
            offset: 60,
            easing: "ease-out-cubic",
          });
        </script>
      </Fragment>
    )}
    <slot name="before" />

    <section id="title">
      <Nav isHome={isHome} />
      <slot name="hero" />
    </section>

    <main id="main-content" class={mainClass}>
      <slot />
    </main>

    <Footer />
    <slot name="scripts" />
  </body>
</html>
