---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { theme } from '../theme/theme';
import { langFromUrl, publicPath, swapLang, t, type Lang } from '../i18n/ui';
import { getGoogleRating } from '../data/googleRating';
import { clinicNode, websiteNode, abs } from '../lib/schema';
import '../styles/theme.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  /** Page-specific JSON-LD nodes; the clinic and website nodes are always added. */
  schema?: object[];
  /** Set false for pages that exist in one language only. */
  translated?: boolean;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, schema = [], translated = true, image = '/images/services/orthopedic-sports-therapy.webp', ogType = 'website', noindex = false } = Astro.props;

const lang: Lang = langFromUrl(Astro.url);
const path = publicPath(Astro.url.pathname);
const canonical = abs(path);
const enPath = swapLang(Astro.url, 'en');
const esPath = swapLang(Astro.url, 'es');
const altPath = translated ? (lang === 'en' ? esPath : enPath) : null;

const rating = await getGoogleRating();
const graph = { '@context': 'https://schema.org', '@graph': [clinicNode(rating), websiteNode(lang), ...schema] };
---

<!doctype html>
<html lang={lang === 'es' ? 'es' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {translated && (
      <Fragment>
        <link rel="alternate" hreflang="en" href={abs(enPath)} />
        <link rel="alternate" hreflang="es" href={abs(esPath)} />
        <link rel="alternate" hreflang="x-default" href={abs(enPath)} />
      </Fragment>
    )}
    <meta name="theme-color" content={theme.themeColor} />
    <link rel="icon" href="/images/brand/p-logo-minty.webp" type="image/webp" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />

    <meta property="og:site_name" content="Powerhouse PT" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(image)} />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    {translated && <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_US'} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={theme.fontsHref} rel="stylesheet" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>

  <body data-theme={theme.id}>
    <a href="#main-content" class="skip-link">{t(lang, 'skip')}</a>
    <slot name="before-header" />
    <Header lang={lang} altPath={altPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
    <slot name="scripts" />
  </body>
</html>
